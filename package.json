{
  "name": "dielineforge",
  "version": "1.0.0",
  "private": true,
  "description": "Free online dieline generator for boxes, envelopes, pouches, cans, tubes, containers and print products. Export PDF, AI, SVG, DXF and EPS.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && npx http-server dist -p 8080 -c-1",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node scripts/build.mjs && playwright test"
  },
  "license": "MIT",
  "dependencies": {
    "clipper-lib": "^6.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "esbuild": "^0.25.10"
  }
}
